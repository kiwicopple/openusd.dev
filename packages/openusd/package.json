{
  "name": "openusd",
  "version": "0.1.0",
  "description": "Read-only provider directory companion to openusd.dev",
  "license": "MIT",
  "homepage": "https://openusd.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiwicopple/openusd.dev.git",
    "directory": "packages/openusd"
  },
  "bugs": {
    "url": "https://github.com/kiwicopple/openusd.dev/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fix-declarations.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "openusd-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "check": "astro check && tsc --noEmit",
    "validate": "node --import tsx scripts/validate.ts",
    "test": "node --import tsx --test scripts/*.test.ts",
    "check:links": "node --import tsx scripts/check-links.ts",
    "check:navigation": "node scripts/check-navigation.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "preview": "astro preview",
    "build:preview": "node scripts/build.mjs --preview",
    "check:seo": "node --import tsx scripts/check-seo.ts",
    "check:agents": "node --import tsx scripts/check-agents.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.3.2",
    "zod": "^4.6.5",
    "@astrojs/react": "^7.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.17.2",
    "pagefind": "^1.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxc-transform-react": "^0.145.0",
    "astro-aeo": "1.5.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
